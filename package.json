{
  "name": "hadria",
  "version": "2.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "private": true,
  "dependencies": {
    "@date-io/moment": "2.17.0",
    "@fontsource/roboto": "4.5.8",
    "@material-ui/core": "^4.11.0",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/pickers": "3.3.11",
    "axios": "1.20.0",
    "bootstrap": "4.6.2",
    "jwt-decode": "^3.0.0",
    "moment": "2.31.0",
    "moment-timezone": "0.5.48",
    "notistack": "^1.0.1",
    "react": "^16.13.1",
    "react-bootstrap": "1.6.8",
    "react-dom": "^16.13.1",
    "react-keyboard-event-handler": "^1.5.4",
    "react-moment": "1.2.3",
    "react-router-dom": "5.3.4",
    "react-to-print": "2.15.1",
    "sirv-cli": "3.0.1",
    "victory": "37.3.6"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "sirv dist --single --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "eslint vite.config.mjs src/index.js src/components/api.js src/components/auth",
    "lint:legacy": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "heroku-postbuild": "npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reloadoskar/hadria-frontend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
